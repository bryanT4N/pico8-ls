{
	"name": "pico-8-ls",
	"displayName": "PICO-8-LS",
	"description": "PICO-8 language server, a personal fork of japhib/pico8-ls",
	"icon": "img/icon.png",
	"author": "JanPaul Bergeson",
	"publisher": "bryanT4N",
	"license": "MIT",
	"version": "0.6.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/bryanT4N/pico8-ls"
	},
	"engines": {
		"vscode": "^1.63.0"
	},
	"activationEvents": [
		"onLanguage:pico-8",
		"onLanguage:pico-8-lua",
		"workspaceContains:**/*.p8"
	],
	"main": "./client/out-min/main.js",
	"categories": [
		"Programming Languages",
		"Snippets"
	],
	"contributes": {
		"commands": [
			{
				"command": "pico-8-ls.formatFile",
				"title": "PICO-8-LS: Format File"
			},
			{
				"command": "pico-8-ls.formatFileSeparateLines",
				"title": "PICO-8-LS: Format File - Each Statement on Separate Line"
			}
		],
		"configuration": {
			"type": "object",
			"title": "PICO-8-LS configuration",
			"properties": {
				"pico-8-ls.maxNumberOfProblems": {
					"scope": "resource",
					"type": "integer",
					"minimum": 0,
					"default": 100,
					"description": "Controls the maximum number of problems produced by the server."
				},
				"pico-8-ls.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Traces the communication between VS Code and the language server."
				},
				"pico-8-ls.outline.showParameters": {
					"scope": "window",
					"type": "boolean",
					"default": false,
					"markdownDescription": "List each function's parameters under it in the outline, breadcrumbs and sticky scroll, and in Go to Symbol in Workspace. `...` is not listed."
				},
				"pico-8-ls.outline.showLoopVariables": {
					"scope": "window",
					"type": "boolean",
					"default": false,
					"markdownDescription": "List the variables of each `for` loop in the outline, breadcrumbs and sticky scroll, and in Go to Symbol in Workspace: under the function the loop is in, or under the loop when `#pico-8-ls.outline.showBlocks#` is on."
				},
				"pico-8-ls.outline.showBlocks": {
					"scope": "window",
					"type": "boolean",
					"default": false,
					"markdownDescription": "Group the outline, breadcrumbs and sticky scroll by the `for`, `while`, `repeat` and `do` blocks and the branches of `if` that hold something they list. A block is named after its first line, as in `for i=1,#enemies`."
				}
			}
		},
		"languages": [
			{
				"id": "pico-8",
				"aliases": [
					"PICO-8",
					"pico-8",
					"PICO8",
					"pico8"
				],
				"extensions": [
					".p8"
				],
				"configuration": "./syntaxes/language-configuration.json",
				"icon": {
					"light": "./img/light/icon.png",
					"dark": "./img/dark/icon.png"
				}
			},
			{
				"id": "pico-8-lua",
				"aliases": [
					"PICO-8 Lua"
				],
				"configuration": "./syntaxes/language-configuration.json",
				"icon": {
					"light": "./img/light/icon.png",
					"dark": "./img/dark/icon.png"
				}
			}
		],
		"grammars": [
			{
				"language": "pico-8",
				"scopeName": "source.pico8",
				"path": "./syntaxes/pico-8.tmLanguage.json"
			},
			{
				"language": "pico-8-lua",
				"scopeName": "source.pico8.lua",
				"path": "./syntaxes/pico-8-lua.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "pico-8",
				"path": "./syntaxes/snippets.json"
			},
			{
				"language": "pico-8-lua",
				"path": "./syntaxes/snippets.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"vscode-publish": "npx @vscode/vsce package && npx @vscode/vsce publish",
		"clean": "rm -rf client/out client/out-min server/out server/out-min",
		"clean-deps": "rm -rf node_modules client/node_modules server/node_modules && npm install",
		
		"compile-tsc": "node node_modules/typescript/bin/tsc -b",

		"compile": "npm run esbuild-client && npm run esbuild-server",
		"esbuild-client": "esbuild ./client/src/extension.ts --bundle --outfile=./client/out-min/main.js --external:vscode --format=cjs --platform=node --minify",
		"esbuild-server": "esbuild ./server/src/server.ts --bundle --outfile=./server/out-min/main.js --external:vscode --format=cjs --platform=node --minify",

		"compile-nomin": "npm run esbuild-client-nomin && npm run esbuild-server-nomin",
		"esbuild-client-nomin": "esbuild ./client/src/extension.ts --bundle --outfile=./client/out-min/main.js --external:vscode --format=cjs --platform=node",
		"esbuild-server-nomin": "esbuild ./server/src/server.ts --bundle --outfile=./server/out-min/main.js --external:vscode --format=cjs --platform=node",

		"lint": "eslint ./client/src ./server/src --ext .ts",
		"lint:fix": "eslint ./client/src ./server/src --ext .ts --fix",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd .."
	},
	"devDependencies": {
		"@types/mocha": "^8.2.2",
		"@types/node": "^12.12.0",
		"@typescript-eslint/eslint-plugin": "^4.23.0",
		"@typescript-eslint/parser": "^4.23.0",
		"esbuild": "^0.14.14",
		"eslint": "^7.26.0",
		"mocha": "^9.2.0",
		"typescript": "^4.4.3"
	}
}
